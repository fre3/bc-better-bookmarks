{
  "manifest_version": 3,
  "name": "Better Bookmarks — Technical MVP",
  "version": "0.1.4",
  "description": "Edge Favorites dashboard with experimental synchronized tags and identity diagnostics.",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "key": ""
}
