{
  "manifest_version": 3,
  "name": "Indexfold",
  "version": "0.1.29",
  "description": "A typography-first bookmark dashboard with instant search and keyboard navigation. Built for Chrome and Edge.",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "tabs"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "key": "",
  "commands": {
    "open-dashboard-search": {
      "description": "Open dashboard in search mode",
      "suggested_key": {
        "windows": "Ctrl+Shift+B"
      },
      "global": false
    }
  }
}
